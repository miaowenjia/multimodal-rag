# Copy this file to .env before starting Docker Compose.
# Replace placeholders with your own keys. Never commit .env.
APP_NAME="Multimodal RAG Service"
APP_ENV=dev
DEBUG=false
HOST=0.0.0.0
PORT=8010

# Inside Compose, use the service name chroma, not localhost.
SQLITE_URL=sqlite:///./data/rag.db
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_chunks
UPLOADS_DIR=./data/uploads
IMAGES_DIR=./data/images

LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-dashscope-api-key
LLM_MODEL_NAME=qwen-plus
LLM_TIMEOUT=120

EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-your-dashscope-api-key
EMBEDDING_MODEL_NAME=text-embedding-v3

# Optional: enable before ingestion if image-caption indexing is needed.
ENABLE_VISION=false
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL_NAME=qwen-vl-max-latest

# Optional: the endpoint must accept POST <base>/reranks (see README).
# Current DB initialization sets enabled=true regardless of this value.
# Disable Reranker in Settings after first startup if not configured.
RERANKER_ENABLED=false
RERANKER_API_BASE=
RERANKER_API_KEY=
RERANKER_MODEL_NAME=
RERANKER_TIMEOUT=60

TOP_K=15
KEYWORD_TOP_K=15
FINAL_TOP_N=8
